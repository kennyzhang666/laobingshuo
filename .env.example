# 复制为 .env 后按需修改。server.py 启动时自动读取同目录的 .env。

# 监听地址和端口
HOST=0.0.0.0
PORT=8090
# 数据目录（数据库、照片、会话密钥），相对路径以 server.py 所在目录为准
DATA_DIR=data
# 登录有效天数
SESSION_DAYS=7

# LDAP：与 AI-Training-Platform 的 ldap3-gateway 配置完全一致，可直接照抄那边的值
LDAP_SERVER=china.huawei.com
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_START_TLS=false
# LDAP_CA_CERT_FILE=/etc/ssl/certs/company-ldap-ca.pem
LDAP_BASE_DN=dc=china,dc=huawei,dc=com
LDAP_BIND_PREFIX=China\
LDAP_ACCOUNT_ATTRIBUTE=sAMAccountName
LDAP_TITLE_ATTRIBUTE=title
LDAP_DEPARTMENT_ATTRIBUTE=department
LDAP_NAME_ATTRIBUTE=displayName
LDAP_TIMEOUT_SECONDS=5

# 仅本地试跑：true 时任意密码都能登录，不连 LDAP。正式环境保持 false。
LDAP_MOCK=false
